{
  "name": "liquidityos-backend",
  "version": "1.0.0",
  "description": "Backend API for FinSight AI Concall & Financial Resilience Intelligence",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "test": "node --test --test-global-setup=tests/helpers/globalSetup.js --test-concurrency=4 tests/*.test.js",
    "test:unit": "node --test tests/engine.test.js tests/market.test.js tests/concall.test.js",
    "db:migrate": "node db/migrate.js",
    "db:import-legacy": "node scripts/import-legacy-users.js",
    "dev:db": "node scripts/dev-db.js start",
    "dev:db:stop": "node scripts/dev-db.js stop",
    "test:remote": "node scripts/test-remote.js",
    "seed:demo": "node scripts/seed-demo.js"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.1",
    "cookie-parser": "1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "7.5.1",
    "helmet": "8.1.0",
    "multer": "2.0.2",
    "pdf-parse": "^1.1.1",
    "pg": "8.16.3",
    "undici": "7.30.0",
    "zod": "3.25.76"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "devDependencies": {
    "embedded-postgres": "15.18.0-beta.17"
  }
}
