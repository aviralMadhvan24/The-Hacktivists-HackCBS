# FinSight backend configuration. Copy to backend/.env and fill in.
# Never commit .env. Only DATABASE_URL and APP_ENCRYPTION_KEY are required.

# ---- Server ------------------------------------------------------------------
PORT=3000
NODE_ENV=development
# Public URL of the web app (Zerodha redirects users back here). Empty = same origin.
WEB_APP_URL=http://localhost:5173
# Extra allowed browser origins (comma separated), e.g. the Vite dev server.
CORS_ORIGINS=http://localhost:5173
# Set to 1 (or true) when running behind a reverse proxy / load balancer.
TRUST_PROXY=
SESSION_TTL_DAYS=7
# Apply database migrations automatically on start (default true).
MIGRATE_ON_START=true

# ---- Database: YugabyteDB (YSQL) ---------------------------------------------
# YugabyteDB Aeon: copy the YSQL connection string from the cluster's Connect page.
#   DATABASE_URL=postgresql://admin:<password>@<host>.aws.yugabyte.cloud:5433/yugabyte
#   DB_SSL=verify-full
#   DB_SSL_ROOT_CERT=/path/to/root.crt   (download from the Aeon Connect page)
# Local development without Aeon: `npm run dev:db` prints a URL for a local Postgres.
DATABASE_URL=
DB_SSL=
DB_SSL_ROOT_CERT=
# Aeon Sandbox allows ~13 connections per node; keep this small there.
DB_POOL_MAX=10

# ---- Secrets at rest -----------------------------------------------------------
# 64 hex chars. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Encrypts broker access tokens. Changing it invalidates stored broker connections.
APP_ENCRYPTION_KEY=

# ---- AI (Gemini preferred) -----------------------------------------------------
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
# Tried in order if the primary is retired (404), overloaded (503), slow, or out of quota (429).
# Free tier: about 20 requests/day per model, so several models give more headroom.
GEMINI_FALLBACK_MODELS=gemini-3.5-flash,gemini-3.5-flash-lite,gemini-3.1-flash-lite,gemini-flash-lite-latest,gemini-flash-latest
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
LLM_TIMEOUT_MS=90000
# Natural voice for spoken answers (falls back to the browser voice).
GEMINI_TTS_MODEL=gemini-2.5-flash-preview-tts
GEMINI_TTS_VOICE=Kore

# ---- Market data ---------------------------------------------------------------
# YAHOO (default; unofficial, delayed) or MOCK (demo prices, development only).
MARKET_DATA_PROVIDER=YAHOO

# ---- Zerodha Kite Connect ------------------------------------------------------
# Create an app at https://developers.kite.trade/ (paid subscription).
# Set the app's redirect URL to: <API base>/api/zerodha/callback
ZERODHA_API_KEY=
ZERODHA_API_SECRET=

# ---- Meko contextual memory (see docs/MEKO.md) -------------------------------
MEKO_ENABLED=false
MEKO_MCP_URL=
MEKO_API_KEY=
MEKO_DATAPACK_ID=

# ---- Forecasting service (see docs/FORECASTING.md) -----------------------------
FORECAST_SERVICE_URL=

# ---- Uploads -----------------------------------------------------------------------
MAX_FILE_SIZE_MB=15
